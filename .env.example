# 复制为 .env 后按需修改（.env 不会提交到 Git）

# ── 品牌 / 页面 ──────────────────────────────────────────
VITE_APP_TITLE=Bible · Reader
VITE_APP_NAME=Bible
# 顶栏图标：emoji 或图片路径（如 /favicon.svg）
VITE_APP_ICON=/favicon.svg
VITE_APP_FAVICON=/favicon.svg
VITE_APP_LANG=zh-Hant

# ── 路由与数据路径 ───────────────────────────────────────
# 本地开发留空或 /；GitHub Pages 项目站 CI 自动设为 /bible/
# VITE_BASE=/bible/
VITE_DEFAULT_ROUTE=/1/1
VITE_JSON_BASE=/json

# ── 默认版本与可选译本（逗号分隔 ID，须与 src/data/versions.js 中一致）──
VITE_DEFAULT_VERSION=cunps
VITE_PRIMARY_VERSIONS=cunps,cunp,niv

# ── localStorage 键名（多实例部署时可区分）──────────────
VITE_STORAGE_KEY_VERSION=bible-version-v2

# ── 布局 / 主题 ─────────────────────────────────────────
VITE_CONTENT_MAX=720px
VITE_HEADER_HEIGHT=56px
VITE_ACCENT_COLOR=#2383e2
# 留空则用 index.css（中文黑体 + 英文 Inter）；自定义时会覆盖整栈，慎写 Inter 在最前
# VITE_FONT_FAMILY=

# ── 开发服务器（仅 vite.config.js，无需 VITE_ 前缀）──────
# DEV_PORT=3650
